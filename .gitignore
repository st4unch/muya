# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local machine system-root CA bundle (for Node TLS behind corporate proxy) — do not commit
.node-ca.pem

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# build/test logs
.tauri-build.log
.tauri-dev.log

# Local agent working state — lessons.md references the notarization AuthKey (.p8) path/id; never commit
tasks/

# Signed/notarized distribution artifacts (released via GitHub, not git)
ApexMissionControl-*.zip
*-arm64.zip
# Build outputs — never committed. An unsigned .pkg in particular must never
# reach a release: Gatekeeper blocks it and the user sees a broken installer.
*-arm64.pkg
*-arm64.app.tar.gz
*-arm64.app.tar.gz.sig

# Local release scripts (build/sign/notarize/publish) — machine-local, not committed
scripts/

# Tauri externalBin staged sidecars (built by build-sign-notarize.sh)
src-tauri/binaries/
src-tauri/doc/
