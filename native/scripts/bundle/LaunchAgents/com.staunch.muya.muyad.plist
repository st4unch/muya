<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>@BUNDLE_ID@</string>
	</array>
	<key>BundleProgram</key>
	<string>Contents/MacOS/muyad</string>
	<!-- Without --broker muyad serves no MCP broker socket, and the muya-mcp sidecar every Claude session starts answers
	     "Muya app not running". argv[0] first, then the flags. -->
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/muyad</string>
		<string>--broker</string>
		<string>--scheduler</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.staunch.muya.muyad</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
</dict>
</plist>
